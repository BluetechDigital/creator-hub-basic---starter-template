NEXT_PUBLIC_GTM_ID=""

# -----------------------------------------------------------------------------
# Nodemailer From Submittion
# -----------------------------------------------------------------------------

EMAIL_USER=""
EMAIL_PASS=""
# "gmail" (and outlook365/hotmail/yahoo/icloud/zoho) are resolved via nodemailer's
# well-known `service` shorthand — see config/nodemailer.ts. Gmail requires an App
# Password (not the account password) if 2FA is enabled. Any other value is treated
# as a literal SMTP hostname instead.
EMAIL_HOST="gmail"
# Optional SMTP port for a literal EMAIL_HOST (ignored for the well-known service
# shorthands above). Defaults to 587 when unset; 465 also enables implicit TLS.
EMAIL_PORT=""
# Optional: who contact-form submissions are delivered to. Falls back to EMAIL_USER
# if unset — set this separately if the creator sends via one address but wants
# submissions landing in a different inbox (e.g. their personal Gmail).
CONTACT_FORM_RECIPIENT_EMAIL=""

# -----------------------------------------------------------------------------
# Google reCAPTCHA v3
# -----------------------------------------------------------------------------

# reCAPTCHA v3 (score-based, invisible) — create a *v3* key pair at
# https://www.google.com/recaptcha/admin (v2 keys will not work). The site key
# is NEXT_PUBLIC_ (loaded client-side); the secret is server-only. Named with
# the GOOGLE_V3_ prefix specifically (not just RECAPTCHA_) so it's unambiguous
# which reCAPTCHA generation is wired up if this project is ever migrated.
# In production, an unset GOOGLE_V3_RECAPTCHA_SECRET_KEY makes form submissions fail closed.
NEXT_PUBLIC_GOOGLE_V3_RECAPTCHA_SITE_KEY=""
GOOGLE_V3_RECAPTCHA_SECRET_KEY=""
# Minimum v3 score (0.0–1.0, higher = more human) a submission must clear.
# Google's default recommendation is 0.5. Optional; defaults to 0.5.
GOOGLE_V3_RECAPTCHA_MIN_SCORE="0.5"