# Shared secret the WordPress `ch-security.php` mu-plugin requires on every
# GraphQL *mutation* (comment/reaction). Set the SAME value here and as a
# `define('CREATOR_HUB_GRAPHQL_PROXY_SECRET', ...)` constant in wp-config.php.
# Generate one with `openssl rand -hex 32`. See wordpress-mu-plugins/README.md
# and docs/comment-security.md. Leave blank and the gate fails open (dev only).
CREATOR_HUB_GRAPHQL_PROXY_SECRET=""

# Remote Patterns for Next.js Image Optimization #
IMAGE_REMOTE_PATTERNS_HOSTNAME_ONE="i0.wp.com"
IMAGE_REMOTE_PATHNAME_ONE="/vzt.nmy.mybluehost.me/----/**"

IMAGE_REMOTE_PATTERNS_HOSTNAME_TWO="vzt.nmy.mybluehost.me"
IMAGE_REMOTE_PATHNAME_TWO="/----/wp-content/uploads/**"

# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# XXXXXXXXXXXXXXXXXXXXXXXXX AZURE AI TRANSLATOR (i18n) XXXXXXXXXXXXXXXXXXXXXXXX
# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Machine-translates CMS content (post title/excerpt/content, SEO/meta text)
# into every non-English locale — see i18n/translateContent.ts. Requires an
# Azure Translator resource (portal.azure.com -> Create a resource ->
# "Translator", under Azure AI Services; the free F0 tier covers 2M
# characters/month). Key and region come from that resource's "Keys and
# Endpoint" page.
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION=""
# Default is Azure's global endpoint; only change this if using a
# region-locked/sovereign-cloud Translator resource.
AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"

# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# XXXXXXXXXXXXXXXXXXXXXXXXXX SOCIAL MEDIA INTEGRATIONS XXXXXXXXXXXXXXXXXXXXXXXX
