# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# XXXXXXXXXXXXXXXXXXXXXXXXX AZURE AI TRANSLATOR (i18n) XXXXXXXXXXXXXXXXXXXXXXXX
# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Machine-translates CMS content (post title/excerpt/content, SEO/meta text)
# into every non-English locale — see i18n/translateContent.ts. Requires an
# Azure Translator resource (portal.azure.com -> Create a resource ->
# "Translator", under Azure AI Services; the free F0 tier covers 2M
# characters/month). Key and region come from that resource's "Keys and
# Endpoint" page.
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION=""
# Default is Azure's global endpoint; only change this if using a
# region-locked/sovereign-cloud Translator resource.
AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"

