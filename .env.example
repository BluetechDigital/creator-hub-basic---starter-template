# -----------------------------------------------------------------------------
# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX INSTAGRAM API XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# -----------------------------------------------------------------------------

# Instagram API (Access Token and Media Type) #
INSTAGRAM_ACCESS_TOKEN=""

# Instagram Images Remote Pattern #
# Instagram serves post media from two CDNs depending on the requesting region
# — *.cdninstagram.com and *.fbcdn.net (e.g. instagram.f<edge>.fna.fbcdn.net).
# Both are wired into next/image's remotePatterns (see next.config.ts).
INSTAGRAM_IMAGE_REMOTE_PATTERNS_HOSTNAME="*.cdninstagram.com"
INSTAGRAM_IMAGE_REMOTE_PATHNAME="/**"
INSTAGRAM_IMAGE_REMOTE_PATTERNS_HOSTNAME_TWO="*.fbcdn.net"
INSTAGRAM_IMAGE_REMOTE_PATHNAME_TWO="/**"

# Instagram token auto-refresh (optional; recommended for production) #
# The long-lived token rotates on every refresh and its original expires 60 days
# after it was minted, so INSTAGRAM_ACCESS_TOKEN can't stay current on its own.
# The weekly cron at /api/instagram/refresh-token (see vercel.json) refreshes it
# and writes the new value to Vercel Edge Config; getInstagramToken() reads from
# there, falling back to INSTAGRAM_ACCESS_TOKEN when these are unset (then update
# it by hand every ~50 days).
#
#   EDGE_CONFIG       - added automatically when an Edge Config store is linked
#                       to the Vercel project (connection string; used for reads).
#                       GLOBAL_CONFIG is also accepted (the name a "Global Config
#                       Store" uses).
#   VERCEL_API_TOKEN  - a Vercel access token with Edge Config write access
#                       (used by the cron to persist the refreshed token)
#   VERCEL_TEAM_ID    - the team the project belongs to (team_… ; omit for a
#                       personal-account project)
#   CRON_SECRET       - any random string; Vercel sends it as the cron request's
#                       Authorization bearer, and the route rejects anything else
CRON_SECRET=""
VERCEL_API_TOKEN=""
VERCEL_TEAM_ID=""

