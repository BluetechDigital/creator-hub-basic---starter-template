# -----------------------------------------------------------------------------

NEXT_PUBLIC_GTM_ID=""

# -----------------------------------------------------------------------------
# Nodemailer From Submittion
# -----------------------------------------------------------------------------

EMAIL_USER=""
EMAIL_PASS=""
# "gmail" (and outlook365/hotmail/yahoo/icloud/zoho) are resolved via nodemailer's
# well-known `service` shorthand — see config/nodemailer.ts. Gmail requires an App
# Password (not the account password) if 2FA is enabled. Any other value is treated
# as a literal SMTP hostname instead.
EMAIL_HOST="gmail"
# Optional: who contact-form submissions are delivered to. Falls back to EMAIL_USER
# if unset — set this separately if the creator sends via one address but wants
# submissions landing in a different inbox (e.g. their personal Gmail).
CONTACT_FORM_RECIPIENT_EMAIL=""

# -----------------------------------------------------------------------------
# Google reCAPTCHA Keys
# -----------------------------------------------------------------------------

# Must be NEXT_PUBLIC_ — the reCAPTCHA widget renders client-side and needs this
# value in the browser bundle.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""